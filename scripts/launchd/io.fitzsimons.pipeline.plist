<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install.sh fills in __HOME__ and __CLONE__ and copies this to
     ~/Library/LaunchAgents. Runs scripts/run_pipeline.sh from the dedicated
     clone every 20 minutes; the script decides what is due. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.fitzsimons.pipeline</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__CLONE__/scripts/run_pipeline.sh</string>
  </array>
  <!-- While asleep, launchd coalesces missed ticks into one run on wake. -->
  <key>StartInterval</key>
  <integer>1200</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/fitzsimons-pipeline/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/fitzsimons-pipeline/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
</dict>
</plist>
